meta {
  name: 06 - Registrar cobro
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "userId": {{qaUserId}},
    "membershipId": {{qaMembershipId}},
    "amount": 350,
    "method": "EFECTIVO"
  }
}

script:pre-request {
  if (bru.getEnvVar("permitirCRUD") !== "SI") { throw new Error("Para una demo autorizada, cambia permitirCRUD a SI en el entorno."); }
  if (!bru.getVar("token") || bru.getVar("tokenBase") !== bru.getEnvVar("baseUrl") || !String(bru.getVar("rol")).split(",").includes("ADMIN")) { throw new Error("Inicia sesion como ADMIN en este entorno."); }
  if (bru.getVar("qaBase") !== bru.getEnvVar("baseUrl")) { throw new Error("Registra primero el socio de prueba en este entorno."); }
  if (!/^\d+$/.test(String(bru.getVar("qaUserId") || ""))) { throw new Error("Falta qaUserId: ejecuta la creacion correspondiente."); }
  if (!/^\d+$/.test(String(bru.getVar("qaMembershipId") || ""))) { throw new Error("Falta qaMembershipId: ejecuta la creacion correspondiente."); }
  if (bru.getVar("qaPaymentId")) { throw new Error("Ya hay un cobro de esta demo."); }
}

script:post-response {
  if (res.getStatus() === 200 && Number.isInteger(res.getBody().id) && (String(res.getBody().userId) === bru.getVar("qaUserId"))) { bru.setVar("qaPaymentId", String(res.getBody().id)); }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Registro de prueba por $350 MXN. No realiza transacciones bancarias.
}
