meta {
  name: 05 - Consultar mensualidades
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/memberships?page=0&size=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Pagina de mensualidades", function () { expect(res.getBody().content).to.be.an("array"); });
}
