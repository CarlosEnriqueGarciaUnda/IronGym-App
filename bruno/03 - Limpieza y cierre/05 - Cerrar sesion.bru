meta {
  name: 05 - Cerrar sesion
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.getStatus() === 200) { bru.setVar("token", ""); bru.setVar("rol", ""); bru.setVar("tokenBase", ""); }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
}
