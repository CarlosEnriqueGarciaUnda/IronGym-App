meta {
  name: 06 - 400 Datos invalidos
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "",
    "email": "correo-invalido",
    "phone": "123",
    "password": "123"
  }
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Errores de campos", function () { expect(res.getBody().fieldErrors).to.be.an("object"); });
}
