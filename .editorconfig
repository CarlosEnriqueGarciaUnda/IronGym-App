# Reglas generales de edición para todo el equipo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,css,json,html}]
indent_style = space
indent_size = 2

[*.java]
indent_style = space
indent_size = 4

[*.{md,sql,xml}]
indent_style = space
indent_size = 2
